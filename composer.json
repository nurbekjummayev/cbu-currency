{
    "name": "cbu/currency",
    "description": "Central Bank of Uzbekistan currency rates package for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jummayev Nurbek",
            "email": "jummayevnurbek279@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "ext-bcmath": "*",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Cbu\\Currency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbu\\Currency\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbu\\Currency\\CbuCurrencyServiceProvider"
            ],
            "aliases": {
                "CbuCurrency": "Cbu\\Currency\\Facades\\CbuCurrency"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
