{
  "name": "nurbekjummayev/cbu-currency",
  "description": "Central Bank of Uzbekistan currency rates package for Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "currency",
    "exchange-rates",
    "cbu",
    "Uzbekistan",
    "central-bank",
    "currency-converter",
    "uzs"
  ],
  "homepage": "https://github.com/nurbekjummayev/cbu-currency",
  "support": {
    "issues": "https://github.com/nurbekjummayev/cbu-currency/issues",
    "source": "https://github.com/nurbekjummayev/cbu-currency"
  },
  "authors": [
    {
      "name": "Nurbek Jummayev",
      "email": "jummayevnurbek279@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-bcmath": "*",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.0",
    "nurbekjummayev/laravel-api-response-helpers": "^1.2"
  },
  "suggest": {
    "laravel/mcp": "Required to expose the CBU Currency MCP server (AI agent tools) (^0.8)."
  },
  "require-dev": {
    "laravel/mcp": "^0.8.1",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.5",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "pestphp/pest": "^2.0|^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Cbu\\Currency\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cbu\\Currency\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cbu\\Currency\\CbuCurrencyServiceProvider"
      ],
      "aliases": {
        "CbuCurrency": "Cbu\\Currency\\Facades\\CbuCurrency"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "lint": "vendor/bin/pint --test",
    "lint:fix": "vendor/bin/pint"
  },
  "scripts-descriptions": {
    "test": "Run the test suite",
    "test:coverage": "Run the test suite with code coverage",
    "lint": "Check code style without fixing",
    "lint:fix": "Fix code style issues"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
